# auto | cpu | qnn
SNAPMIND_BACKEND=auto
# Optional AI Hub/QNN-exported token-classification model. Model artifacts are not committed.
SNAPMIND_MODEL_PATH=models/pii_token_classifier.onnx
# QNN provider options are installation-specific. Never put credentials here.
SNAPMIND_HOST=127.0.0.1
SNAPMIND_PORT=8000

